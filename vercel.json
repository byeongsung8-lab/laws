{
  "version": 2,
  "public": true,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/download/(.*)", "destination": "/api/index.js" },
    { "source": "/", "destination": "/public/index.html" },
    { "source": "/list", "destination": "/public/list.html" },
    { "source": "/view", "destination": "/public/view.html" },
    { "source": "/admin", "destination": "/public/admin.html" },
    { "source": "/(.*)", "destination": "/public/$1" }
  ]
}
